---
// A cover band (CHARTER §8.3.3): image panel on the program's panel color beside
// a cream info panel. Bands alternate sides by index. The whole band is one link;
// its accessible name is the title, and the two lines below describe it.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MetaLine from './MetaLine.astro';
import Placeholder from './Placeholder.astro';
import { projectHref, type Project } from '../lib/content';
import { ratio, slot } from '../lib/slots';
import { SHOW_TODOS, isPending, noteText, type Pending } from '../lib/todo';

interface Props {
  entry: Project;
  index: number;
  /** Load the first band's images eagerly: it is the page's largest image. */
  priority?: boolean;
}

const { entry, index, priority = false } = Astro.props;
const d = entry.data;
const reverse = index % 2 === 1;
const key = `${entry.collection}-${entry.id}`;

const photo = d.cover.photo as Pending<ImageMetadata> | undefined;
const realPhoto = photo && !isPending(photo) ? photo : undefined;
const gridImages = d.cover.images
  .map((i) => i.image as Pending<ImageMetadata>)
  .filter((i): i is ImageMetadata => !isPending(i));

// What the image panel shows, given the content that exists and the render mode.
type Variant = 'poster' | 'poster-photo' | 'grid' | 'none';
let variant: Variant = 'none';
if (d.cover.mode === 'grid') {
  // The showcase ladder (design spec §4.4): none → text band; one → as a poster; nine → the 3×3.
  if (gridImages.length >= 9 || (SHOW_TODOS && gridImages.length === 0)) variant = 'grid';
  else if (gridImages.length > 0) variant = 'poster';
} else if (d.poster) {
  variant = d.cover.mode === 'poster+photo' && (realPhoto || (SHOW_TODOS && photo)) ? 'poster-photo' : 'poster';
}
const lead = d.poster ?? (variant === 'poster' ? gridImages[0] : undefined);

// A tint behind each image while it loads: a step lighter on dark panels, darker on light ones.
const luminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5]
    .map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const tint =
  luminance(d.cover.panelColor) < 0.18
    ? 'color-mix(in oklab, var(--panel), white 8%)'
    : 'color-mix(in oklab, var(--panel), #1F1A19 8%)';

const line = d.cover.line ? [d.cover.line] : [d.type, d.role];
const meta = [d.cover.place ?? d.place, d.dateShort];
---

<a
  class:list={['band', { 'band--reverse': reverse, 'band--text': variant === 'none' }]}
  href={projectHref(entry)}
  style={`--panel: ${d.cover.panelColor}; --ph: ${tint}; --vt-name: poster-${key}`}
  aria-labelledby={`${key}-title`}
  aria-describedby={`${key}-meta`}
>
  {
    variant !== 'none' && (
      <div class:list={['band-media', `band-media--${variant}`]}>
        {(variant === 'poster' || variant === 'poster-photo') && lead && (
          <Picture
            src={lead}
            alt=""
            formats={['avif']}
            fallbackFormat="webp"
            {...slot('coverPoster', lead)}
            class="band__poster"
            style={`--r: ${ratio(lead)}`}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
          />
        )}
        {variant === 'poster-photo' &&
          (realPhoto ? (
            <Picture
              src={realPhoto}
              alt=""
              formats={['avif']}
              fallbackFormat="webp"
              {...slot('coverPhoto', realPhoto)}
              class="band__photo"
              loading={priority ? 'eager' : 'lazy'}
            />
          ) : (
            <Placeholder tone="dark" caption={noteText((photo as { todo: string }).todo) || 'Photo'} class="band__photo" />
          ))}
        {variant === 'grid' &&
          (gridImages.length > 0
            ? gridImages
                .slice(0, 9)
                .map((img) => <Picture src={img} alt="" formats={['avif']} fallbackFormat="webp" {...slot('gridCell', img)} class="band__cell" />)
            : Array.from({ length: 9 }, (_, i) =>
                i === 4 ? (
                  <Placeholder tone="deep" caption={noteText(d.cover.caption) || 'Images to come'} />
                ) : (
                  <Placeholder tone={i % 2 === 0 ? 'light' : 'mid'} caption="" />
                ),
              ))}
      </div>
    )
  }
  <div class="band-info">
    <h2 class="band__title" id={`${key}-title`}>
      <span class="band__title-text" lang={d.titleLang === 'es' ? 'es' : undefined}>{d.title}</span>
    </h2>
    <div class="band__lines" id={`${key}-meta`}>
      <MetaLine class="band__line" parts={line} />
      <MetaLine class="band__meta" parts={meta} />
    </div>
  </div>
</a>

<style>
  .band,
  .band:hover {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    color: var(--ink);
    text-decoration: none;
  }

  .band--reverse {
    flex-direction: row-reverse;
  }

  .band:focus-visible {
    outline-offset: 6px;
  }

  .band-media {
    container: media / inline-size;
    flex: 3 1 420px;
    height: 440px;
    padding: 18px;
    overflow: hidden;
    background-color: var(--panel);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .band-media :global(picture) {
    display: contents;
  }

  .band-media--poster-photo {
    justify-content: flex-start;
    align-items: stretch;
  }

  .band-media--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    transition: transform var(--t-lift-out) var(--ease-out);
  }

  .band-media :global(.band__poster) {
    display: block;
    flex: none;
    height: 100%;
    width: auto;
    max-width: 100%;
    aspect-ratio: var(--r);
    object-fit: contain;
    background-color: var(--ph);
    transition: transform var(--t-lift-out) var(--ease-out);
  }

  .band-media :global(.band__photo) {
    flex: 1;
    min-width: 0;
    height: 100%;
    object-fit: cover;
    background-color: var(--ph);
  }

  .band-media :global(.band__photo.placeholder) {
    padding: 16px;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--ph-band-ink);
  }

  .band-media :global(.band__cell) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: var(--ph);
  }

  .band-info {
    container: info / inline-size;
    flex: 2 1 300px;
    min-height: 260px;
    background-color: var(--cream);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 8px;
    padding: 32px;
  }

  .band--text .band-info {
    flex: 1 1 100%;
  }

  .band__title {
    font-size: var(--fs-cover-title);
    line-height: 1.2;
    font-weight: 500;
    text-wrap: balance;
  }

  .band__title-text {
    padding-bottom: 3px;
    background: linear-gradient(currentColor, currentColor) 50% 100% / 0% 1px no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition:
      color var(--t-color) ease,
      background-size var(--t-line-out) var(--ease-out);
  }

  .band__lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .band__lines :global(.band__line) {
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .band__lines :global(.band__meta) {
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--muted);
  }

  @media (max-width: 1239.98px) {
    .band__lines :global(.band__meta) {
      text-wrap: balance;
    }
  }

  /* Hover and focus: the title takes oxblood and a hairline; the poster lifts. */
  @media (hover: hover) and (pointer: fine) {
    .band:hover .band__title-text {
      color: var(--oxblood);
      background-size: 100% 1px;
      transition-duration: var(--t-color), var(--t-line-in);
    }
  }

  .band:focus-visible .band__title-text {
    color: var(--oxblood);
    background-size: 100% 1px;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .band:hover :global(.band__poster),
    .band:hover .band-media--grid {
      transform: scale(1.02);
      transition-duration: var(--t-lift-in);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .band:focus-visible :global(.band__poster),
    .band:focus-visible .band-media--grid {
      transform: scale(1.02);
      transition-duration: var(--t-lift-in);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band__title-text {
      transition: color var(--t-color) ease;
    }
  }

  /* Narrow info panels: one fact per line. */
  @container info (width < 420px) {
    .band__lines :global(.seg) {
      display: block;
    }

    .band__lines :global(.sep) {
      display: none;
    }
  }

  /* Bands stack below 720px of content: a square image plate above the info. */
  @container page (width < 720px) {
    .band,
    .band--reverse {
      flex-direction: column;
    }

    .band-media {
      flex: none;
      height: min(100cqi, 440px);
    }

    .band-info {
      flex: none;
      width: 100%;
      min-height: 0;
      padding: 22px 24px 26px;
      gap: 6px;
    }

    .band__lines {
      gap: 6px;
    }
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .band-media {
      height: min(440px, 86svh);
    }
  }

  /* No room for the event photo beside the poster: show the poster alone. */
  @container media (width < 524px) {
    .band-media--poster-photo {
      justify-content: center;
    }

    .band-media :global(.band__photo) {
      display: none;
    }
  }
</style>
