---
import { Font } from 'astro:assets';
import Header, { type Section } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/content';
import { ogPath, siteCard } from '../lib/og';
import { withBase } from '../lib/paths';
import { SHOW_TODOS, clean } from '../lib/todo';
import '../styles/tokens.css';
import '../styles/global.css';

declare const __INDEXABLE__: boolean;

interface Props {
  /** Page name; the site name is appended. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Path of the share card, from src/lib/og.ts. Defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  section?: Section;
  atIndex?: boolean;
  /** Preload the italic too, where it shows above the fold. */
  preloadItalic?: boolean;
}

const site = await getSite();
const {
  title,
  description = site.description,
  ogImage = ogPath(await siteCard()),
  ogImageAlt = 'Posters for Iyuana, Ayazamana and Herencia Viva',
  section,
  atIndex,
  preloadItalic = false,
} = Astro.props;

const pageTitle = `${SHOW_TODOS ? '[Review] ' : ''}${title ? `${clean(title)} · ${site.name}` : site.name}`;
const summary = clean(description);
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const shareImage = new URL(withBase(ogImage), Astro.site);

// Prerender a page when a link to it is hovered or pressed, so the next page is
// ready and the poster carries straight into it. A JSON rule, not script (CHARTER §16).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const speculation = JSON.stringify({
  prerender: [{ where: { and: [{ href_matches: `${base}/*` }, { not: { href_matches: `${base}/*.pdf` } }] }, eagerness: 'moderate' }],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    {!__INDEXABLE__ && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {__INDEXABLE__ && <link rel="sitemap" href={withBase('/sitemap-index.xml')} />}
    <Font
      cssVariable="--font-garamond"
      preload={preloadItalic ? [{ weight: '400', style: 'normal' }, { weight: '400', style: 'italic' }] : [{ weight: '400', style: 'normal' }]}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ? clean(title) : site.name} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={clean(ogImageAlt)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="speculationrules" set:html={speculation} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <Header section={section} atIndex={atIndex} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
