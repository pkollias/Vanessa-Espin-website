---
import Base from '../layouts/Base.astro';
import CoverBand from '../components/CoverBand.astro';
import Text from '../components/Text.astro';
import { getPrograms, getSite } from '../lib/content';
import { withBase } from '../lib/paths';

const site = await getSite();
const programs = await getPrograms();
---

<Base section="programs" atIndex preloadItalic>
  <section class="masthead">
    <h1>{site.masthead}</h1>
    <a href={withBase('/brand-work')} class="masthead__link hit"><Text value={site.brandLink} /></a>
  </section>

  <div class="bands">
    {programs.map((entry, index) => <CoverBand entry={entry} index={index} priority={index === 0} />)}
  </div>
</Base>

<style>
  .masthead {
    padding: var(--sp-60) 0 var(--sp-52);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  h1 {
    max-width: 820px;
    font-size: var(--fs-statement);
    line-height: 1.35;
    font-weight: 400;
    color: var(--ink);
    text-wrap: balance;
  }

  .masthead__link {
    font-size: 1.125rem;
    color: var(--oxblood);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition:
      color var(--t-color) ease,
      box-shadow var(--t-color) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .masthead__link:hover {
      color: var(--oxblood);
      box-shadow: 0 1px 0 0 currentColor;
    }
  }

  .bands {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: var(--sp-72);
  }
</style>
